{
  "manifest_version": 3,
  "name": "Walled DLP Guard",
  "short_name": "Walled DLP",
  "version": "1.0.0",
  "description": "Browser sensor for the Walled DLP Guard desktop agent: inspects prompts and file uploads on ChatGPT and Perplexity and recolours AI responses.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"],
      "js": ["content.js"],
      "css": ["response-color.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Walled DLP Guard", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
